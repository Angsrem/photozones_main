// Prisma schema — аренда фотозон в Красноярске
// PostgreSQL. Json → JSONB (с индексами), даты → нативный DATE.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== Менеджеры (админы) =====
model Manager {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  role         String   @default("MANAGER") // MANAGER | ADMIN
  telegramId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads     Lead[]     @relation("ManagerLeads")
  bookings  Booking[]
  blocks    DateBlock[]
}

// ===== Фотозоны =====
model PhotoZone {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  category    String   // FRAME | PRESSWALL | TEXTILE | THEME
  occasions   Json     // string[]: WEDDING, BIRTHDAY, GRADUATION, CORPORATE, NEW_YEAR, MARCH_8, FEB_23
  basePrice   Int      // рублей
  sizeW       Float?   // ширина, м
  sizeH       Float?   // высота, м
  images      Json     // string[] (URL)
  videos      Json?    // string[] (URL видео для автоплея в каталоге/карточке)
  includes    Json     // string[] — что входит (доставка/монтаж/демонтаж/срок)
  badge       String?  // HIT | NEW | null
  hit         Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(100)
  // теги для квиза (мэтчинг)
  styles      Json?    // string[]: romantic, minimal, neon, party, rustic, retro, brand, kids-fairytale, classic, disco
  sizeClass   String?  // S | M | L | XL (по размеру → числу гостей)
  childAge    Json?    // string[] для детских: 1-3, 4-7, 8-12, 13-17
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  elements  Element[]
  leads     Lead[]
  bookings  Booking[]
  blocks    DateBlock[]

  @@index([category])
  @@index([isActive])
}

// ===== Дополнительные опции (буквы, шары, подсветка, реквизит, освещение) =====
// Может быть привязан к конкретной фотозоне (photozoneId) или быть глобальным (null)
// category группирует опции в карточке: letter | decor | prop | lighting | service
model Element {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  image       String?  // превью опции (для освещения — фото светильника)
  category    String   @default("decor") // letter | decor | prop | lighting | service
  photozoneId String?  // null = глобальная опция (доступна всем фотозонам)
  photozone   PhotoZone? @relation(fields: [photozoneId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([photozoneId])
  @@index([category])
}

// ===== Заявки =====
model Lead {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  phone       String
  eventDate   String   // желаемая дата (ISO yyyy-mm-dd)
  occasion    String?  // повод
  comment     String?

  // источник
  source      String?  // страница/путь
  sourcePage  String?  // например /katalog/love
  utm         Json?    // {source, medium, campaign, content, term}
  referrer    String?

  // состав заказа
  photozoneId String?
  photozone   PhotoZone? @relation(fields: [photozoneId], references: [id], onDelete: SetNull)
  config      Json?    // полная конфигурация (калькулятор/конструктор)
  priceEstimate Int?  // ориентировочная цена

  // обработка
  status      String   @default("NEW") // NEW | CALLED | CONFIRMED | DECLINED | DONE
  managerId   String?
  manager     Manager?   @relation("ManagerLeads", fields: [managerId], references: [id], onDelete: SetNull)
  managerNote String?

  bookings Booking[]
  promoCodes PromoCode[]  // выданные этому клиенту промокоды

  @@index([status])
  @@index([eventDate])
  @@index([createdAt])
}

// ===== Бронирование (создаётся при CONFIRMED или ручная блокировка) =====
model Booking {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  managerId   String?
  manager     Manager?  @relation(fields: [managerId], references: [id], onDelete: SetNull)

  photozoneId String?
  photozone   PhotoZone? @relation(fields: [photozoneId], references: [id], onDelete: Cascade)
  elementIds  Json?    // string[] — id элементов (читаем вручную, relation на Json не поддерживается)

  date        String   // ISO yyyy-mm-dd
  note        String?

  @@index([date])
  @@index([photozoneId])
  @@index([leadId])
}

// ===== Ручная блокировка дат (техобслуживание, выкуп) =====
model DateBlock {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  date        String   // ISO yyyy-mm-dd
  photozoneId String?
  photozone   PhotoZone? @relation(fields: [photozoneId], references: [id], onDelete: Cascade)
  managerId   String?
  manager     Manager?  @relation(fields: [managerId], references: [id], onDelete: SetNull)
  reason      String?  // service | reserved | other

  @@unique([date, photozoneId])
  @@index([date])
}

// ===== Акции / сезонные офферы =====
model Promo {
  id          String   @id @default(cuid())
  title       String
  description String?
  discount    Int?     // %
  code        String?  // промокод (например QUIZ5)
  activeFrom  DateTime?
  activeTo    DateTime?
  pages       Json?    // string[] — на каких страницах показывать
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== Персональные промокоды за отзывы (реферальная механика) =====
// code вида FOTO-XXXX, генерируется менеджером после подтверждения отзыва
// singleUse=true, transferable=true (можно передать другу), срок 12 мес.
model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique  // FOTO-A7KX
  discountPct Int      @default(5)  // %
  type        String   @default("review")  // review | referral | campaign
  leadId      String?  // кому выдан (клиент)
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  singleUse   Boolean  @default(true)
  transferable Boolean @default(true)  // можно передать другу
  expiresAt   DateTime  // +12 мес от выдачи
  status      String   @default("ACTIVE")  // ACTIVE | USED | EXPIRED
  usedByLeadId String? // кем использован (если передали другу)
  usedAt      DateTime?
  note        String?  // комментарий менеджера
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([leadId])
  @@index([status])
}

// ===== Сессии квиза (/podborka/[id]) =====
model QuizSession {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime // живёт 90 дней
  answers         Json     // {occasion, childAge?, style, guests, budget, date?}
  recommendedIds  Json     // string[] — id фотозон [эконом, хит, премиум]
  promoCode       String?  // QUIZ5
  // контакт (если отправили себе)
  contact         String?  // телефон или email
  channel         String?  // whatsapp | telegram | phone | email
  // метрики виральности
  views           Int      @default(0)
  orders          Int      @default(0)
  source          String?  // откуда запущен квиз (страница)

  @@index([expiresAt])
}

// ===== Отзывы =====
model Review {
  id          String   @id @default(cuid())
  author      String
  event       String?  // повод
  text        String
  photos      Json?    // string[] (URL)
  videos      Json?    // string[] (URL видео)
  rating      Int      @default(5) // 1..5
  photozoneId String?  // привязка к фотозоне (null = общий отзыв)
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(false) // false = на модерации
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@index([photozoneId])
}

// ===== Блог-статьи =====
model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String   // markdown
  cover       String?
  tags        Json?    // string[]
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== Редактируемые страницы (контентные блоки) =====
// slug = ключ страницы (например "home", "ceny", "svadby-hero")
// blocks = JSON-массив блоков: [{type:'heading', text, level}, {type:'paragraph', text}, ...]
model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String   // название для админки
  description String?  // что это за страница
  blocks      Json     // JSON-массив контентных блоков
  isPublished Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ===== Partial-лиды (брошенные квизы) =====
model QuizPartial {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  answers     Json     // частичные ответы {occasion?, childAge?, style?, guests?, budget?, step}
  step        Int      // на каком шаге бросил (1..6)
  source      String?  // страница запуска
  utm         Json?    // utm-метки
  converted   Boolean  @default(false) // дошёл ли до результата
  sessionId   String?  // если дошёл — id QuizSession
}
