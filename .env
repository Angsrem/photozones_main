DATABASE_URL=file:/home/z/my-project/db/custom.db

# ===== Telegram-уведомления о новых заявках =====
# 1. Создайте бота через @BotFather в Telegram → получите токен
# 2. Узнайте свой chat_id через @userinfobot (или отправьте боту любое сообщение и вызовите getUpdates)
# 3. Отправьте боту любое сообщение (бот должен писать вам первым — иначе не сможет)
# 4. Впишите значения ниже и перезапустите dev-сервер
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# ===== Email-уведомления (дублируют Telegram) =====
# Получите ключ на https://resend.com (3000 писем/мес бесплатно)
RESEND_API_KEY=
RESEND_FROM=ФотоЗона24 <noreply@fotozona24.ru>
MANAGER_EMAIL=order@fotozona24.ru

# ===== JWT-секрет для админ-сессий =====
